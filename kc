#!/usr/bin/env python3
"""kleincannon CLI — self-contained vertical-video pipeline.

Usage:
  ./kc new       --topic "..." [--purpose "..."] [--beats N] [--voice chris]
  ./kc tts       [-e ID] [--voice chris] [--speed 1.0]
  ./kc align     [-e ID]
  ./kc prompts   [-e ID]
  ./kc images    [-e ID] [--fast] [--force] [--seed N]
  ./kc captions  [-e ID]
  ./kc build     [-e ID]
  ./kc all       --topic "..." [--purpose "..."] [--manual-script "..."] [--fast]
  ./kc sheet     [-e ID]
  ./kc status    [-e ID]
  ./kc doctor

Most stages take -e <episode-id>; omit it to use the most recently modified episode.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

from kleincannon import config
from kleincannon.episode import Episode, latest_episode_id

import kleincannon.stages.script as script_stage
import kleincannon.stages.tts as tts_stage
import kleincannon.stages.align as align_stage
import kleincannon.stages.prompts as prompts_stage
import kleincannon.stages.images as images_stage
import kleincannon.stages.captions as captions_stage
import kleincannon.stages.assemble as assemble_stage


def _id(args) -> str:
    if args.episode:
        return args.episode
    return latest_episode_id()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="kc", description="kleincannon pipeline")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_ep(sp):
        sp.add_argument("-e", "--episode", help="episode id (default: latest)")

    sp = sub.add_parser("new", help="create a new episode (use --manual-script or AI)")
    sp.add_argument("--topic", required=True)
    sp.add_argument("--purpose", default="")
    sp.add_argument("--manual-script", default="", help="one sentence per beat, newline-separated")
    sp.add_argument("--beats", type=int, default=6)
    sp.add_argument("--voice", default=config.DEFAULT_VOICE)

    sp = sub.add_parser("tts")
    add_ep(sp); sp.add_argument("--voice"); sp.add_argument("--speed", type=float, default=1.0)

    sp = sub.add_parser("align"); add_ep(sp)
    sp = sub.add_parser("prompts"); add_ep(sp)
    sp = sub.add_parser("images"); add_ep(sp)
    sp.add_argument("--fast", action="store_true")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--seed", type=int)
    sp = sub.add_parser("captions"); add_ep(sp)
    sp = sub.add_parser("build"); add_ep(sp)

    sp = sub.add_parser("all", help="one-shot: topic -> final mp4")
    sp.add_argument("--topic", required=True)
    sp.add_argument("--purpose", default="")
    sp.add_argument("--manual-script", default="")
    sp.add_argument("--beats", type=int, default=6)
    sp.add_argument("--voice", default=config.DEFAULT_VOICE)
    sp.add_argument("--fast", action="store_true")

    sp = sub.add_parser("sheet"); add_ep(sp)
    sp = sub.add_parser("status"); add_ep(sp)
    sp = sub.add_parser("doctor")
    args = p.parse_args(argv)

    if args.cmd == "new":
        if args.manual_script.strip():
            ep = script_stage.from_text(args.topic, args.manual_script.strip().splitlines(),
                                        purpose=args.purpose, voice=args.voice)
        else:
            ep = script_stage.from_ai(args.topic, purpose=args.purpose,
                                      beats=args.beats, voice=args.voice)
        print("created:", ep.id)
        return 0

    if args.cmd == "tts":
        tts_stage.run(_id(args), speed=args.speed, voice=args.voice)
    elif args.cmd == "align":
        align_stage.run(_id(args))
    elif args.cmd == "prompts":
        prompts_stage.run(_id(args))
    elif args.cmd == "images":
        images_stage.run(_id(args), fast=args.fast, force=args.force, seed=args.seed)
    elif args.cmd == "captions":
        captions_stage.run(_id(args))
    elif args.cmd == "build":
        assemble_stage.run(_id(args))
    elif args.cmd == "sheet":
        ep = Episode.load(_id(args))
        print(f"\n=== {ep.id} ===")
        print(f"topic:    {ep.topic}")
        print(f"purpose:  {ep.purpose}")
        print(f"voice:    {ep.voice}")
        print(f"duration: {ep.total_duration:.2f}s  (speech {ep.speech_end:.2f}s)")
        print(f"audio:    {ep.voice_audio}")
        print("beats:")
        for b in ep.beats:
            print(f"  {b.id}  {b.audio_start:>6.2f}→{b.audio_end:>6.2f}  img={b.image}  {b.text}")
        print(f"final:    {ep.final}")
    elif args.cmd == "status":
        ep = Episode.load(_id(args))
        print(f"{ep.id}  voices={'yes' if ep.voice_audio else 'no'}  "
              f"images={sum(1 for b in ep.beats if b.image)}/{len(ep.beats)}  "
              f"final={'yes' if ep.final else 'no'}")
    elif args.cmd == "doctor":
        _doctor()
    elif args.cmd == "all":
        ep = None
        if args.manual_script.strip():
            ep = script_stage.from_text(args.topic, args.manual_script.strip().splitlines(),
                                        purpose=args.purpose, voice=args.voice)
        else:
            ep = script_stage.from_ai(args.topic, purpose=args.purpose, beats=args.beats,
                                      voice=args.voice)
        eid = ep.id
        tts_stage.run(eid, voice=args.voice)
        align_stage.run(eid)
        prompts_stage.run(eid)
        images_stage.run(eid, fast=args.fast)
        captions_stage.run(eid)
        assemble_stage.run(eid)
        print(f"\nDONE -> episodes/{eid}/{eid}.mp4")
    return 0


def _doctor() -> None:
    from kleincannon import comfy
    import shutil, subprocess
    print("=== kleincannon doctor ===")
    print(f"ffmpeg:        {config.FFMPEG}  "
          f"{'OK' if Path(config.FFMPEG).exists() else 'MISSING'}")
    # text-filter probe
    if Path(config.FFMPEG).exists():
        out = subprocess.run([config.FFMPEG, "-hide_banner", "-filters"], capture_output=True, text=True)
        has = "subtitles" in out.stdout or "drawtext" in out.stdout
        print(f"  libass/drawtext: {'present' if has else 'absent (using Pillow PNG overlay)'}")

    settings = comfy.workflow_settings()
    print(f"klein workflow: {config.COMFY_WORKFLOW}  "
          f"{'OK' if config.COMFY_WORKFLOW.exists() else 'MISSING'}")
    print(f"  native render: {settings.get('width')}x{settings.get('height')}  "
          f"steps={settings.get('steps')}  cfg={settings.get('cfg')}")
    print(f"  ComfyUI server: expected at {config.COMFY_URL} — "
          f"{'running' if comfy.is_up() else 'NOT running (start it before `kc images`)'}")
    print(f"ComfyUI dir:   {config.COMFY_DIR}  {'OK' if config.COMFY_DIR.exists() else 'MISSING'}")
    gguf = config.COMFY_DIR / "models" / "diffusion_models" / "flux-2-klein-4b-Q4_K_M.gguf"
    print(f"FLUX.2-klein:  {gguf}  {'OK' if gguf.exists() else 'MISSING (run scripts/fetch_models.py)'}")
    print(f"TTS engine:    Qwen3-TTS via mlx-audio ({config.QWEN3_MODEL_ID})")
    print(f"  mlx-audio:   {'installed' if _pkg_ok('mlx_audio') else 'MISSING (pip install mlx-audio)'}")
    voice = config.VOICES / f"{config.DEFAULT_VOICE}.wav"
    print(f"default voice: {voice} {'OK' if voice.exists() else 'MISSING'} "
          f"(transcript auto-derived by whisper; no .txt needed)")
    print(f"LLM (gemma4): {'OK' if llm_is_up() else 'not running (manual-script mode works)'}")
    print(f"episodes dir: {config.EPISODES}")


def llm_is_up() -> bool:
    try:
        import urllib.request
        urllib.request.urlopen(config.LLM_URL + "/health", timeout=2)
        return True
    except Exception:
        return False


def _pkg_ok(name: str) -> bool:
    import importlib.util
    return importlib.util.find_spec(name) is not None


if __name__ == "__main__":
    raise SystemExit(main())
