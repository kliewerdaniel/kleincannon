#!/usr/bin/env python3
"""kleincannon CLI — self-contained vertical-video pipeline.

Usage:
  ./kc new       --topic "..." [--purpose "..."] [--beats N] [--voice chris]
  ./kc tts       [-e ID] [--voice chris] [--speed 1.0]
  ./kc align     [-e ID]
  ./kc prompts   [-e ID]
  ./kc images    [-e ID] [--fast] [--force] [--seed N]
  ./kc captions  [-e ID]
  ./kc build     [-e ID]
  ./kc all       --topic "..." [--purpose "..."] [--manual-script "..."] [--fast]
  ./kc sheet     [-e ID]
  ./kc status    [-e ID]
  ./kc doctor

Most stages take -e <episode-id>; omit it to use the most recently modified episode.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from kleincannon import config
from kleincannon.episode import Episode, latest_episode_id

import kleincannon.stages.script as script_stage
import kleincannon.stages.tts as tts_stage
import kleincannon.stages.align as align_stage
import kleincannon.stages.prompts as prompts_stage
import kleincannon.stages.images as images_stage
import kleincannon.stages.captions as captions_stage
import kleincannon.stages.assemble as assemble_stage


def _id(args) -> str:
    if args.episode:
        return args.episode
    return latest_episode_id()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="kc", description="kleincannon pipeline")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_ep(sp):
        sp.add_argument("-e", "--episode", help="episode id (default: latest)")

    sp = sub.add_parser("new", help="create a new episode (use --manual-script or AI)")
    sp.add_argument("--topic", required=True)
    sp.add_argument("--purpose", default="")
    sp.add_argument("--manual-script", default="", help="one sentence per beat, newline-separated")
    sp.add_argument("--beats", type=int, default=6)
    sp.add_argument("--voice", default=config.DEFAULT_VOICE)
    sp.add_argument("--speed", type=float, default=None, help="TTS speed multiplier (e.g. 1.12)")
    sp.add_argument("--style", default="auto",
                    help="visual style name from the catalog, or a custom suffix, or 'auto'")

    sp = sub.add_parser("tts")
    add_ep(sp); sp.add_argument("--voice"); sp.add_argument("--speed", type=float, default=None)

    sp = sub.add_parser("align"); add_ep(sp)
    sp = sub.add_parser("prompts"); add_ep(sp)
    sp.add_argument("--style", default="auto",
                    help="force a visual style (catalog name | custom suffix | 'auto')")
    sp = sub.add_parser("images"); add_ep(sp)
    sp.add_argument("--fast", action="store_true")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--seed", type=int)
    sp.add_argument("--steps", type=int, default=None,
                    help="override sampler steps (None = workflow default)")
    sp.add_argument("--cfg", type=float, default=None,
                    help="override CFG scale (None = workflow default)")
    sp = sub.add_parser("captions"); add_ep(sp)
    sp = sub.add_parser("build"); add_ep(sp)

    sp = sub.add_parser("all", help="one-shot: topic -> final mp4")
    sp.add_argument("--topic", required=True)
    sp.add_argument("--purpose", default="")
    sp.add_argument("--manual-script", default="")
    sp.add_argument("--beats", type=int, default=6)
    sp.add_argument("--voice", default=config.DEFAULT_VOICE)
    sp.add_argument("--speed", type=float, default=None, help="TTS speed multiplier")
    sp.add_argument("--style", default="auto",
                    help="visual style name | custom suffix | 'auto'")
    sp.add_argument("--fast", action="store_true")

    sp = sub.add_parser("sheet"); add_ep(sp)
    sp = sub.add_parser("status"); add_ep(sp)
    sp = sub.add_parser("doctor")

    # ---- learning subsystem (autonomous optimization) ----
    lp = sub.add_parser("learn", help="autonomous learning / optimization engine")
    learn_sub = lp.add_subparsers(dest="learn_cmd", required=True)
    linit = learn_sub.add_parser("init", help="create learn config + DB, no network")
    lrun = learn_sub.add_parser("cycle", help="prepare candidates + choose best (+publish package in manual mode)")
    lrun.add_argument("-e", "--episode", required=True)
    lrun.add_argument("--niche", default="")
    lrun.add_argument("--hashtags", default="", help="comma-separated")
    lrun.add_argument("--caption", default="")
    lrun.add_argument("--privacy", default=None, help="SELF_ONLY | PUBLIC_TO_ALL")
    lrun.add_argument("--parent", default=None, help="parent experience id (lineage)")
    lrun.add_argument("--manual", action="store_true", help="force manual publish package (default)")
    lrun.add_argument("--auto", action="store_true", help="force auto-upload via TikTok adapter (needs token)")
    lrun.add_argument("--no-train", action="store_true")
    lharv = learn_sub.add_parser("harvest", help="poll due metric snapshots for all posted")
    ltrain = learn_sub.add_parser("train", help="retrain bandit from full history")
    lstatus = learn_sub.add_parser("status", help="engine + experience summary")
    lrec = learn_sub.add_parser("recommend", help="best next generation config for an episode")
    lrec.add_argument("-e", "--episode", required=True)
    lpend = learn_sub.add_parser("pending", help="list publish packages awaiting manual upload")
    lrec2 = learn_sub.add_parser("record", help="record metrics for a manually-uploaded video")
    lrec2.add_argument("experience_id", help="id from `kc learn pending` / cycle output")
    lrec2.add_argument("--views", type=float, default=0.0)
    lrec2.add_argument("--likes", type=float, default=0.0)
    lrec2.add_argument("--comments", type=float, default=0.0)
    lrec2.add_argument("--shares", type=float, default=0.0)
    lrec2.add_argument("--saves", type=float, default=0.0)
    lrec2.add_argument("--followers", type=float, default=0.0, help="followers_gained")
    lrec2.add_argument("--watch-time", type=float, default=0.0)
    lrec2.add_argument("--completion", type=float, default=0.0, help="completion_rate 0..1")
    lrec2.add_argument("--profile-visits", type=float, default=0.0)
    lrec2.add_argument("--video-id", default=None, help="TikTok video id (optional)")
    lrec2.add_argument("--no-mark-uploaded", action="store_true", help="only append a snapshot, don't flip status")
    lhist = learn_sub.add_parser("history", help="models + experiments")
    lreset = learn_sub.add_parser("reset", help="wipe bandit model (keep DB)")
    args = p.parse_args(argv)

    if args.cmd == "new":
        if args.manual_script.strip():
            ep = script_stage.from_text(args.topic, args.manual_script.strip().splitlines(),
                                        purpose=args.purpose, voice=args.voice)
        else:
            ep = script_stage.from_ai(args.topic, purpose=args.purpose,
                                      beats=args.beats, voice=args.voice)
        if args.speed is not None:
            ep.speed = args.speed
        if args.style and args.style != "auto":
            ep.style = args.style
        ep.save()
        print("created:", ep.id)
        return 0

    if args.cmd == "tts":
        tts_stage.run(_id(args), voice=args.voice, speed=args.speed)
    elif args.cmd == "align":
        align_stage.run(_id(args))
    elif args.cmd == "prompts":
        prompts_stage.run(_id(args), style_suffix=args.style)
    elif args.cmd == "images":
        images_stage.run(_id(args), fast=args.fast, force=args.force,
                         seed=args.seed,
                         steps=getattr(args, "steps", None),
                         cfg=getattr(args, "cfg", None))
    elif args.cmd == "captions":
        captions_stage.run(_id(args))
    elif args.cmd == "build":
        assemble_stage.run(_id(args))
    elif args.cmd == "sheet":
        ep = Episode.load(_id(args))
        print(f"\n=== {ep.id} ===")
        print(f"topic:    {ep.topic}")
        print(f"purpose:  {ep.purpose}")
        print(f"voice:    {ep.voice}")
        print(f"duration: {ep.total_duration:.2f}s  (speech {ep.speech_end:.2f}s)")
        print(f"audio:    {ep.voice_audio}")
        print("beats:")
        for b in ep.beats:
            print(f"  {b.id}  {b.audio_start:>6.2f}→{b.audio_end:>6.2f}  img={b.image}  {b.text}")
        print(f"final:    {ep.final}")
    elif args.cmd == "status":
        ep = Episode.load(_id(args))
        print(f"{ep.id}  voices={'yes' if ep.voice_audio else 'no'}  "
              f"images={sum(1 for b in ep.beats if b.image)}/{len(ep.beats)}  "
              f"final={'yes' if ep.final else 'no'}")
    elif args.cmd == "doctor":
        _doctor()
    elif args.cmd == "learn":
        from kleincannon.learn import agency, harvester as hv, trainer as tr, engine as eng
        from kleincannon.learn import learn_config
        if args.learn_cmd == "init":
            learn_config.save()
            dbg = __import__("kleincannon.learn.db", fromlist=["open_db"]).open_db()
            print("learn subsystem initialised:")
            print(f"  config: {learn_config._path}")
            print(f"  db:     {learn_config.db_path}")
            print(f"  platform: {learn_config.platform} "
                  f"({'authenticated' if learn_config.token_path and __import__('pathlib').Path(learn_config.token_path).exists() else 'mock/local'})")
            print(f"  reward preset: {learn_config.active_reward_preset}")
            dbg.close()
        elif args.learn_cmd == "cycle":
            hashtags = [h.strip() for h in args.hashtags.split(",") if h.strip()]
            # manual/auto override (config default is manual_upload=True)
            if args.auto:
                learn_config.manual_upload = False
            elif args.manual:
                learn_config.manual_upload = True
            out = agency.run_cycle(
                args.episode, niche=args.niche, hashtags=hashtags,
                caption=args.caption, parent_id=args.parent, privacy=args.privacy,
                auto_train=not args.no_train)
            print(json.dumps(out, indent=2, default=str))
        elif args.learn_cmd == "pending":
            pkgs = agency.pending_packages()
            print(json.dumps(pkgs, indent=2, default=str))
        elif args.learn_cmd == "record":
            metrics = {
                "views": args.views, "likes": args.likes, "comments": args.comments,
                "shares": args.shares, "saves": args.saves,
                "followers_gained": args.followers, "watch_time": args.watch_time,
                "completion_rate": args.completion, "profile_visits": args.profile_visits,
            }
            metrics = {k: v for k, v in metrics.items() if v}
            out = agency.record_metrics(args.experience_id, metrics,
                                        mark_uploaded=not args.no_mark_uploaded,
                                        video_id=args.video_id)
            print(json.dumps(out, indent=2, default=str))
        elif args.learn_cmd == "harvest":
            out = hv.harvest_all()
            print(json.dumps(out, indent=2, default=str))
        elif args.learn_cmd == "train":
            out = tr.train_from_history()
            print(json.dumps(out, indent=2, default=str))
        elif args.learn_cmd == "status":
            print(json.dumps(agency.status(), indent=2, default=str))
        elif args.learn_cmd == "recommend":
            from kleincannon.learn import optimize
            from kleincannon.episode import Episode
            ep = Episode.load(args.episode)
            cands = optimize.optimize(ep)
            best = cands[0]
            print(json.dumps({
                "episode": args.episode,
                "recommended_variation": best.get("variation"),
                "predicted_reward": best.get("_predicted_reward"),
                "uncertainty": best.get("_uncertainty"),
                "top5": [{"variation": c.get("variation"),
                          "predicted_reward": c.get("_predicted_reward")} for c in cands[:5]],
            }, indent=2))
        elif args.learn_cmd == "history":
            out = tr.history()
            print(json.dumps(out, indent=2, default=str))
        elif args.learn_cmd == "reset":
            p2 = __import__("pathlib").Path(learn_config.learn_dir) / "bandit_model.npz"
            if p2.exists():
                p2.unlink()
            eng.reset_engine()
            print("bandit model wiped (experience DB preserved).")
    elif args.cmd == "all":
        ep = None
        if args.manual_script.strip():
            ep = script_stage.from_text(args.topic, args.manual_script.strip().splitlines(),
                                        purpose=args.purpose, voice=args.voice)
        else:
            ep = script_stage.from_ai(args.topic, purpose=args.purpose, beats=args.beats,
                                      voice=args.voice)
        if args.speed is not None:
            ep.speed = args.speed
        if args.style and args.style != "auto":
            ep.style = args.style
        ep.save()
        eid = ep.id
        tts_stage.run(eid, voice=args.voice, speed=args.speed)
        align_stage.run(eid)
        prompts_stage.run(eid, style_suffix=args.style)
        images_stage.run(eid, fast=args.fast, force=True)
        captions_stage.run(eid)
        assemble_stage.run(eid)
        print(f"\nDONE -> episodes/{eid}/{eid}.mp4")
    return 0


def _doctor() -> None:
    from kleincannon import comfy
    import shutil, subprocess
    print("=== kleincannon doctor ===")
    print(f"ffmpeg:        {config.FFMPEG}  "
          f"{'OK' if Path(config.FFMPEG).exists() else 'MISSING'}")
    # text-filter probe
    if Path(config.FFMPEG).exists():
        out = subprocess.run([config.FFMPEG, "-hide_banner", "-filters"], capture_output=True, text=True)
        has = "subtitles" in out.stdout or "drawtext" in out.stdout
        print(f"  libass/drawtext: {'present' if has else 'absent (using Pillow PNG overlay)'}")

    settings = comfy.workflow_settings()
    print(f"klein workflow: {config.COMFY_WORKFLOW}  "
          f"{'OK' if config.COMFY_WORKFLOW.exists() else 'MISSING'}")
    print(f"  native render: {settings.get('width')}x{settings.get('height')}  "
          f"steps={settings.get('steps')}  cfg={settings.get('cfg')}")
    print(f"  ComfyUI server: expected at {config.COMFY_URL} — "
          f"{'running' if comfy.is_up() else 'NOT running (start it before `kc images`)'}")
    print(f"ComfyUI dir:   {config.COMFY_DIR}  {'OK' if config.COMFY_DIR.exists() else 'MISSING'}")
    gguf = config.COMFY_DIR / "models" / "diffusion_models" / "flux-2-klein-4b-Q4_K_M.gguf"
    print(f"FLUX.2-klein:  {gguf}  {'OK' if gguf.exists() else 'MISSING (run scripts/fetch_models.py)'}")
    print(f"TTS engine:    Qwen3-TTS via mlx-audio ({config.QWEN3_MODEL_ID})")
    print(f"  mlx-audio:   {'installed' if _pkg_ok('mlx_audio') else 'MISSING (pip install mlx-audio)'}")
    print(f"  default speed: {config.DEFAULT_TTS_SPEED}x (narration pacing)")
    print(f"  style catalog: {len(config.STYLE_CATALOG)} looks available "
          f"(e.g. {', '.join(s['name'] for s in config.STYLE_CATALOG[:4])} …)")
    print(f"  style rule: each topic auto-picks a distinct look; override with --style")
    voice = config.VOICES / f"{config.DEFAULT_VOICE}.wav"
    print(f"default voice: {voice} {'OK' if voice.exists() else 'MISSING'} "
          f"(transcript auto-derived by whisper; no .txt needed)")
    print(f"LLM (gemma4): {'OK' if llm_is_up() else 'not running (manual-script mode works)'}")
    print(f"episodes dir: {config.EPISODES}")


def llm_is_up() -> bool:
    try:
        import urllib.request
        urllib.request.urlopen(config.LLM_URL + "/health", timeout=2)
        return True
    except Exception:
        return False


def _pkg_ok(name: str) -> bool:
    import importlib.util
    return importlib.util.find_spec(name) is not None


if __name__ == "__main__":
    raise SystemExit(main())
