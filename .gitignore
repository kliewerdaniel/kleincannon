# virtual env
venv/
.venv/

# model weights + downloaded reference assets
models/
*.gguf
*.safetensors
*.bin

# episode media (the rendered outputs are large; keep only manifests)
episodes/*/images/
episodes/*/audio/
episodes/*/captions/
episodes/*/*.mp4
episodes/*/*.wav
!episodes/.gitkeep

# reference voice CLIPS (keep transcripts/placeholder)
voices/*.wav
voices/*.mp3
voices/*.flac
voices/*.ogg
# auto-transcribed ref_text cache sidecar (derived from the clip, regenerated)
voices/*.reftext
!voices/README.md

# python
__pycache__/
*.pyc
.pytest_cache/

# env / secrets
.env
*.log

# OS
.DS_Store

# learning subsystem RUNTIME data (experience DB, trained models, OAuth token
# — machine-local). NOTE: only the top-level learn/ data dir is ignored;
# the SOURCE package kleincannon/learn/ must stay tracked.
/learn/
/learn/pending/

# ---- public-repo hygiene: never push these to a public remote ----
# agent runtime state (tool outputs, past conversation logs, local state)
.hermes/

# local scratch / debug dumps
_dump/
_dump_src.py
_ls.txt
_probe_marker.txt
probe_term.txt
probe_write.txt

# local knowledge graph (stays local per D19 — graph never leaves the machine)
knowledge/

# rendered episode media + local artifacts (3.3GB, machine-local)
episodes/

# one-off episode build scripts (scratch, not part of the fleet project)
scripts/
