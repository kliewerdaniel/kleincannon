# virtual env
venv/
.venv/

# model weights + downloaded reference assets
models/
*.gguf
*.safetensors
*.bin

# episode media (the rendered outputs are large; keep only manifests)
episodes/*/images/
episodes/*/audio/
episodes/*/captions/
episodes/*/*.mp4
episodes/*/*.wav
!episodes/.gitkeep

# reference voice CLIPS (keep transcripts/placeholder)
voices/*.wav
voices/*.mp3
voices/*.flac
voices/*.ogg
# auto-transcribed ref_text cache sidecar (derived from the clip, regenerated)
voices/*.reftext
!voices/README.md

# python
__pycache__/
*.pyc
.pytest_cache/

# env / secrets
.env
*.log

# OS
.DS_Store

# learning subsystem RUNTIME data (experience DB, trained models, OAuth token
# — machine-local). NOTE: only the top-level learn/ data dir is ignored;
# the SOURCE package kleincannon/learn/ must stay tracked.
/learn/
