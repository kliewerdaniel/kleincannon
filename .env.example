# kleincannon config overrides — copy to .env and edit, or set in config.py.
# Most paths are computed from your home dir automatically; override here only if
# your ComfyUI / LLM / voices live elsewhere.

# Where ComfyUI lives (the image backend). The pipeline auto-launches it.
KLEIN_COMFY_DIR=/Users/danielkliewer/Documents/Projects/image/ComfyUI

# Optional LLM for AI script/image-prompt writing (gemma4 via llama.cpp).
LLM_GGUF=/Users/danielkliewer/Documents/Projects/chopnscrwbot/gemma-4-26B-A4B-it-ultra-uncensored-heretic-Q4_K_M.gguf
LLM_PORT=8080

# Default reference voice (clip in voices/<name>.<ext> + voices/<name>.txt).
DEFAULT_VOICE=chris
